# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".
export RELEASE_DISTRIBUTION=name
# export RELEASE_NODE=<%= @release.name %>

# Set the node name from the env var instead of the default hostname-based name
export RELEASE_NODE="${RELEASE_NODE:-activities@127.0.0.1}"
export RELEASE_COOKIE="${RELEASE_COOKIE}"
export ERL_DIST_PORT="${ERL_DIST_PORT:-9000}"
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -kernel inet_dist_listen_min ${ERL_DIST_PORT} inet_dist_listen_max ${ERL_DIST_PORT}"